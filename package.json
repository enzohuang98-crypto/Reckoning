{
  "name": "xiangqi-analyzer",
  "version": "0.4.28",
  "description": "象棋 AI 分析講解軟體 — Pikafish 引擎 + LLM 結構化解釋 (MVP)",
  "main": "./out/main/index.js",
  "author": "xiangqi-analyzer",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tests": "tsc -p tsconfig.test.node.json && tsc -p tsconfig.test.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tests",
    "test": "node tools/test/run-tests.mjs",
    "security:check": "tsx --tsconfig tsconfig.node.json tests/security/security.test.ts",
    "security:audit": "node tools/security/audit-dependencies.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:update": "npm run build && electron-builder --config electron-builder.publish.cjs --publish never",
    "dist:update:github": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/build-github-update.ps1",
    "verify:update": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/verify-update-artifacts.ps1",
    "verify:signature": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/release/verify-signature.ps1",
    "smoke:installer": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/release/smoke-installer.ps1",
    "publish:update:github": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/publish-github-update.ps1",
    "test:ipc-review": "tsx --tsconfig tsconfig.node.json tests/unit/main/ipcReviewBoundary.test.ts",
    "test:updater-sdk": "electron tests/integration/main/electronUpdaterSdkFixture.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  }
}
